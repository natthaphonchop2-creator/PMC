{
  "name": "pmc-ads-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "booking:test": "vitest run apps/pmc-google-booking-ops/tests",
    "booking:typecheck": "tsc -p apps/pmc-google-booking-ops/tsconfig.json --noEmit",
    "booking:build": "node apps/pmc-google-booking-ops/scripts/build.mjs",
    "booking:push": "cd apps/pmc-google-booking-ops && clasp push",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "node dist-server/server/productionServer.js",
    "test": "vitest run"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "googleapis": "^176.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google/clasp": "^3.3.0",
    "@types/google-apps-script": "^2.0.12",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
