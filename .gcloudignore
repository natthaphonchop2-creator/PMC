# Cloud Run source deploy allowlist. Keep local evidence, reports, and credentials out.
**
!.gcloudignore
!package.json
!package-lock.json
!Procfile
!index.html
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!tsconfig.server.json
!vite.config.ts
!src/
!src/**
!server/
!server/**
!assets/
!assets/**
!public/
!public/**
**/.DS_Store
